@page "/products"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime // Inyectamos IJSRuntime para poder usar 'confirm'

<h3>Catálogo de Productos</h3>

<button class="btn btn-success mb-3" @onclick="GoToCreateProduct">Crear Nuevo Producto</button>

@if (products == null && string.IsNullOrEmpty(errorMessage))
{
    <p><em>Cargando productos...</em></p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (!products.Any())
{
    <p>No hay productos en el catálogo. ¡Crea el primero!</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in products)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Description</td>
                    <td>@product.Price.ToString("C")</td>
                    <td>@product.Stock</td>
                    <td>
                        <button class="btn btn-sm btn-primary" @onclick="() => GoToEditProduct(product.Id)">Editar</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteProduct(product.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ProductDto>? products; // Cambiamos a List<T> para poder eliminar elementos
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        try
        {
            var productList = await Http.GetFromJsonAsync<List<ProductDto>>("https://localhost:5001/api/products");
            if (productList != null)
            {
                products = productList;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar productos: {ex.Message}";
        }
    }

    private async Task DeleteProduct(int productId)
    {
        // Mostramos una confirmación de JavaScript
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "¿Estás seguro de que quieres eliminar este producto?");
        if (confirmed)
        {
            try
            {
                var response = await Http.DeleteAsync($"https://localhost:5001/api/products/{productId}");
                if (response.IsSuccessStatusCode)
                {
                    // Si la API lo borró con éxito, lo quitamos de la lista local
                    var productToRemove = products?.FirstOrDefault(p => p.Id == productId);
                    if (productToRemove != null)
                    {
                        products.Remove(productToRemove);
                        StateHasChanged(); // Notifica a Blazor que debe redibujar la tabla
                    }
                }
                else
                {
                    errorMessage = "Error al eliminar el producto.";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error: {ex.Message}";
            }
        }
    }

    private void GoToCreateProduct()
    {
        NavigationManager.NavigateTo("/products/create");
    }

    private void GoToEditProduct(int productId)
    {
        // Lógica para editar (la haremos en el siguiente paso)
        NavigationManager.NavigateTo($"/products/edit/{productId}");
    }

    // ... (la clase ProductDto que ya tenías)
}