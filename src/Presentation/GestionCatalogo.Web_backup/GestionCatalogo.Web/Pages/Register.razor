@page "/register"
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<h3>Registro</h3>

<EditForm Model="@registerDto" OnValidSubmit="HandleRegistration">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group mb-2">
        <label>Usuario:</label>
        <InputText class="form-control" @bind-Value="registerDto.Username" />
    </div>
    <div class="form-group mb-2">
        <label>Contraseña:</label>
        <InputText type="password" class="form-control" @bind-Value="registerDto.Password" />
    </div>
    <button type="submit" class="btn btn-primary">Registrar</button>
</EditForm>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3" role="alert">
        @errorMessage
    </div>
}

@code {
    private RegisterDto registerDto = new();
    private string? errorMessage;

    private async Task HandleRegistration()
    {
        errorMessage = null;
        var success = await AuthService.RegisterAsync(registerDto);

        if (success)
        {
            NavigationManager.NavigateTo("/login");
        }
        else
        {
            errorMessage = "El registro falló. El usuario podría ya existir.";
        }
    }
}